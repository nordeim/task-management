# Tuesday.com — Task Management: environment configuration
#
# This is the ENTIRE configuration surface: one variable, no API keys.
# Verified against the codebase (src/lib reads only DATABASE_URL via
# Prisma's env(); NODE_ENV is framework-managed and never user-set).
#
# Setup:
#   cp .env.example .env
#   bun install
#   bun run db:push      # creates ./db/custom.db from prisma/schema.prisma
#   bun run db:seed      # demo account + 4 boards + 9 groups + 25 tasks
#   bun run dev          # http://localhost:3000
#
# Demo login (seeded, intentionally public): sepnetflix2023@outlook.com / Abcd1234

# SQLite database location. Prisma resolves this path relative to
# prisma/schema.prisma, so "file:../db/custom.db" lands at ./db/custom.db
# in the project root. db/*.db is gitignored — the schema + seed are the
# truth; the file is always recreatable.
DATABASE_URL=file:../db/custom.db
